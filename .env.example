# ==========================================
# ECHO DOCKER COMPOSE CONFIGURATION EXAMPLE
# ==========================================

# Host Ports
FRONTEND_PORT=80
BACKEND_PORT=5001
MONGO_PORT=27017

# Backend Configuration
PORT=5000
# For local Docker Mongo container:
MONGODB_URI=mongodb://mongodb:27017/echo
# For cloud MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/echo?retryWrites=true&w=majority

# Frontend Build Arguments
VITE_API_URL=/api
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset
